#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
QLIB_DIR="${ROOT_DIR}/../qlib"
PYTHONPATH="${ROOT_DIR}/src:${PYTHONPATH:-}"
if [ -d "${QLIB_DIR}" ]; then
  PYTHONPATH="${QLIB_DIR}:${PYTHONPATH}"
fi
export PYTHONPATH

exec python3 -m tushare_qlib "$@"
