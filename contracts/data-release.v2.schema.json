{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/contracts/data-release.v2.schema.json",
  "title": "Composite DataRelease v2",
  "type": "object",
  "required": ["schemaVersion", "dataReleaseId", "profile", "assetClass", "market", "universe", "benchmark", "coverage", "asOfTime", "identitySha256", "manifestSha256", "requiredComponents", "components", "policies", "lineage"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "dataReleaseId": {"pattern": "^ds_[a-f0-9]{64}$"},
    "profile": {"type": "string", "minLength": 1},
    "assetClass": {"type": "string", "minLength": 1},
    "market": {"type": "string", "minLength": 1},
    "universe": {"type": "string", "minLength": 1},
    "benchmark": {"type": "string", "minLength": 1},
    "coverage": {"$ref": "#/$defs/coverage"},
    "asOfTime": {"type": "string"},
    "identitySha256": {"pattern": "^[a-f0-9]{64}$"},
    "manifestSha256": {"pattern": "^[a-f0-9]{64}$"},
    "requiredComponents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "policies": {"type": "object"},
    "lineage": {"type": "object"}
  },
  "$defs": {
    "coverage": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string"}, "end": {"type": "string"}}, "additionalProperties": false},
    "file": {"type": "object", "required": ["path", "sha256", "sizeBytes"], "properties": {"path": {"type": "string"}, "sha256": {"pattern": "^[a-f0-9]{64}$"}, "sizeBytes": {"type": "integer", "minimum": 0}, "rowCount": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "component": {"type": "object", "required": ["role", "componentReleaseId", "datasetKey", "schemaVersion", "coverage", "componentSha256", "files"], "properties": {"role": {"type": "string"}, "componentReleaseId": {"type": "string"}, "datasetKey": {"type": "string"}, "schemaVersion": {"type": "string"}, "coverage": {"$ref": "#/$defs/coverage"}, "componentSha256": {"pattern": "^[a-f0-9]{64}$"}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}}, "additionalProperties": true}
  },
  "additionalProperties": false
}
