{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/contracts/qlib-research-import.v2.schema.json",
  "title": "Qlib Research Import v2",
  "type": "object",
  "required": ["schemaVersion", "importType", "externalRunId", "runKind", "rootArtifactIds", "artifacts"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "importType": {"const": "QLIB_RESEARCH_BUNDLE"},
    "externalRunId": {"type": "string", "minLength": 1},
    "runKind": {"type": "string", "minLength": 1},
    "name": {"type": ["string", "null"]},
    "rootArtifactIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "payloadRef": {"type": "object", "required": ["objectKey", "sha256", "mediaType"], "properties": {"objectKey": {"type": "string", "minLength": 1}, "sha256": {"pattern": "^[a-f0-9]{64}$"}, "mediaType": {"type": "string", "minLength": 1}, "rows": {"type": ["integer", "null"], "minimum": 0}}, "additionalProperties": false},
    "artifact": {
      "type": "object",
      "required": ["schemaVersion", "artifactId", "artifactType", "promotionStatus", "dataReleaseId", "gitCommit", "containerDigest", "asOfTime", "timezone", "currency", "payloadSha256", "parentArtifactIds", "payloadRef", "metadata"],
      "properties": {
        "schemaVersion": {"const": "2.0"},
        "artifactId": {"type": "string", "minLength": 1},
        "artifactType": {"enum": ["MODEL_RELEASE", "STRATEGY_POLICY", "SIGNAL_SNAPSHOT", "TARGET_PORTFOLIO", "VALIDATION_RESULT"]},
        "promotionStatus": {"enum": ["CANDIDATE", "RESEARCH_REVIEW", "RESEARCH_PROMOTED", "REJECTED"]},
        "dataReleaseId": {"pattern": "^ds_[a-f0-9]{64}$"},
        "universeReleaseId": {"type": ["string", "null"]},
        "modelReleaseId": {"type": ["string", "null"]},
        "strategyPolicyId": {"type": ["string", "null"]},
        "gitCommit": {"type": "string", "minLength": 1},
        "containerDigest": {"type": "string", "minLength": 1},
        "asOfTime": {"type": "string", "minLength": 1},
        "signalDate": {"type": ["string", "null"]},
        "tradeDate": {"type": ["string", "null"]},
        "timezone": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 1},
        "payloadSha256": {"pattern": "^[a-f0-9]{64}$"},
        "parentArtifactIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "payloadRef": {"$ref": "#/$defs/payloadRef"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
