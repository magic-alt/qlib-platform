# Standalone data root. Use an absolute path on production machines.
QLIB_DATA_ROOT=/absolute/path/to/qlib-platform-data
TUSHARE_CALLS_PER_MINUTE=180

# Optional: uncomment only when this machine downloads from TuShare.
# TUSHARE_TOKEN=

# Optional: source-checkout/provider overrides.
# QLIB_REPO=/absolute/path/to/qlib
# QLIB_DATA_URI=/absolute/path/to/data/qlib/cn_tushare_v1

# Optional: integrated mode only (configs/pipeline.integrated.yaml).
# QUANT_DATA_ROOT=/absolute/path/to/platform/data
# DATASET_RELEASE_ID=ds_<64_HEX_CHARS>

# Optional lean-platform MySQL backend
# LEAN_MYSQL_DSN=mysql://user:password@host:3306/database
# LEAN_MYSQL_HOST=127.0.0.1
# LEAN_MYSQL_PORT=3306
# LEAN_MYSQL_USER=your_user
# LEAN_MYSQL_PASSWORD=your_pass
# LEAN_MYSQL_DB=lean_market
